// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum IdeaStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VoteType {
  UPVOTE
  DOWNVOTE
}

enum ResourceType {
  AD_CREATIVE
  BRAND_PACKAGE
  LANDING_PAGE
  BUSINESS_PLAN
  PITCH_DECK
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  username      String?   @unique
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  ideas         Idea[]
  votes         Vote[]
  comments      Comment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Idea {
  id              String      @id @default(cuid())
  title           String
  slug            String      @unique
  description     String      @db.Text
  status          IdeaStatus  @default(PENDING)
  category        String
  marketType      String      @map("market_type")
  targetAudience  String      @map("target_audience") @db.Text
  upvoteCount     Int         @default(0) @map("upvote_count")
  viewCount       Int         @default(0) @map("view_count")
  userId          String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis        IdeaAnalysis?
  trends          TrendData[]
  resources       BuildResource[]
  votes           Vote[]
  comments        Comment[]

  @@index([status])
  @@index([category])
  @@index([slug])
}

model IdeaAnalysis {
  id            String   @id @default(cuid())
  ideaId        String   @unique @map("idea_id")
  whyNow        Json     @map("why_now")
  proofSignals  Json     @map("proof_signals")
  marketGap     Json     @map("market_gap")
  executionPlan Json     @map("execution_plan")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  idea          Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
}

model TrendData {
  id         String   @id @default(cuid())
  ideaId     String   @map("idea_id")
  platform   String
  metricName String   @map("metric_name")
  score      Int
  createdAt  DateTime @default(now())

  idea       Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
}

model BuildResource {
  id           String       @id @default(cuid())
  ideaId       String       @map("idea_id")
  resourceType ResourceType @map("resource_type")
  aiTool       String?      @map("ai_tool")
  content      Json
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  idea         Idea         @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
}

model Vote {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  ideaId    String   @map("idea_id")
  voteType  VoteType @map("vote_type")
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@unique([userId, ideaId])
  @@index([ideaId])
}

model Comment {
  id        String    @id @default(cuid())
  content   String    @db.Text
  userId    String    @map("user_id")
  ideaId    String    @map("idea_id")
  parentId  String?   @map("parent_id")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  idea      Idea      @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")

  @@index([ideaId])
  @@index([userId])
}
